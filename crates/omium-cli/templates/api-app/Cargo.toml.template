[package]
name = "omium-api-app"
default-run = "omium-api-app"
description = "Omium JSON API application base"
version = "0.0.0"
edition.workspace = true
publish = false

[lints]
workspace = true

[lib]
name = "omium_api_app"
path = "src/lib.rs"

[[bin]]
name = "omium-api-app"
path = "src/main.rs"

[[bin]]
name = "route-list"
path = "src/bin/route_list.rs"
doc = false

[dependencies]
axum = { workspace = true }
omium-core = { path = "../../crates/omium-core" }
omium-db = { path = "../../crates/omium-db" }
omium-http = { path = "../../crates/omium-http" }
omium-view = { path = "../../crates/omium-view" }
sea-orm = { workspace = true }
serde = { workspace = true }
serde_json = { workspace = true }
thiserror = { workspace = true }
tokio = { workspace = true }
tower-http = { workspace = true, features = ["fs"] }
tracing = { workspace = true }

[dev-dependencies]
http-body-util = "0.1"
omium_api_app_migration = { path = "./migration", package = "omium-api-app-migration" }
tower = { workspace = true }
