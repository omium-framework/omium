[package]
name = "omium-standard-app"
default-run = "omium-standard-app"
description = "Omium standard (Askama HTML) application base"
version = "0.0.0"
edition.workspace = true
publish = false

[package.metadata.askama]
# Askama 0.14 reads template dirs from `askama.toml` at the app root (see repo file).
dirs = ["resources/views"]

[lints]
workspace = true

[lib]
name = "omium_standard_app"
path = "src/lib.rs"

[[bin]]
name = "omium-standard-app"
path = "src/main.rs"

[[bin]]
name = "route-list"
path = "src/bin/route_list.rs"
doc = false

[dependencies]
askama = "0.14"
axum = { workspace = true }
omium-core = { path = "../../crates/omium-core" }
omium-db = { path = "../../crates/omium-db" }
omium-http = { path = "../../crates/omium-http" }
omium-view = { path = "../../crates/omium-view" }
sea-orm = { workspace = true }
serde = { workspace = true }
serde_json = { workspace = true }
thiserror = { workspace = true }
tokio = { workspace = true }
tower-http = { workspace = true, features = ["fs"] }
tracing = { workspace = true }

[dev-dependencies]
http-body-util = "0.1"
omium_standard_app_migration = { path = "./migration", package = "omium-standard-app-migration" }
tower = { workspace = true }
